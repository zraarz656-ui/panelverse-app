# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional secondary key for free uncensored vision models (google/gemini-2.0-flash-exp:free, qwen/qwen-2.5-vl-72b-instruct:free, etc.)
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase Configuration
SUPABASE_URL="https://ahizfmtvgrfujoipmtdq.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://ahizfmtvgrfujoipmtdq.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWKS_URL="https://ahizfmtvgrfujoipmtdq.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
